# quadsim + the toolchain of the G23 controller (g2_deploy_rs): Rust, C++ (OCS2 / Pinocchio via cmeel),
# so the controller is built and run inside the container (docker/build_g23.sh, sim_node spawns it).
# The controller repo itself is mounted at /g2 by docker/run.sh (QUADSIM_G23=1), never copied in.
FROM quadsim:latest

USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build pkg-config libssl-dev libeigen3-dev libudev-dev \
      python3-venv python3-pip rsync zip unzip tmux curl wget git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

USER syncrobotic
ENV RUSTUP_HOME=/home/syncrobotic/.rustup \
    CARGO_HOME=/home/syncrobotic/.cargo \
    PATH=/home/syncrobotic/.cargo/bin:$PATH \
    G2_DEPLOY_RS=/g2
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && cargo --version
WORKDIR /ws
