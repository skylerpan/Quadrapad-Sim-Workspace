<mujoco model="g23">
<!-- G2.3 MJCF. Dynamics / kinematics / limits must match SyncAI-Robot-Description urdf/G23_capsule.urdf (see ../provenance.json, tests/test_model_consistency.py). Collision: capsules + torso boxes at z=0.01 as in the URDF, plus back-shell / head geoms (from g23_fixbody.xml, not in the URDF). -->
  <compiler angle="radian" autolimits="true" meshdir="../meshes/"/>

  <default>
    <default class="robot">
      <default class="motor">
        <joint/>
        <motor/>
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1" group="1" solref="0.005 1" friction="1 0.01 0.01"/>
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="visualgeom" rgba="0.7 0.7 0.7 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="collision_material" rgba="0.0 0.4 0.8 0.2"/>
    <texture type="2d" name="checker" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.9 0.9 0.9" width="500" height="500"/>
    <material name="checker_mat" texture="checker" specular="1" shininess="1" texrepeat="15 15"/>

    <mesh name="torso_g23" file="jeff_2_3_body_low_res.stl"/>
    <mesh name="hip" file="hip.STL"/>
    <mesh name="hip_right" file="hip.STL" scale="1 -1 1"/>
    <mesh name="hip_rear_left" file="hip.STL" scale="-1 1 1"/>
    <mesh name="hip_rear_right" file="hip.STL" scale="-1 -1 1"/>
    <mesh name="thigh" file="thigh.STL"/>
    <mesh name="thigh_right" file="thigh.STL" scale="1 -1 1"/>
    <mesh name="shank" file="shank.STL"/>
  </asset>

