# Copy to .env (packaging/build_bundle.sh writes one next to the .run it builds).
QUADSIM_RUN=../quadsim-<ver>-linux-aarch64.run
# Extra args for the sim, as scripts/run_sim.sh, e.g. --dds-config /dds/my.xml lidar.range_noise=0.0
QUADSIM_ARGS=
# Host port for the web viewer.
QUADSIM_WEB_PORT=8755
# DDS (quadsim/dds_config.py): empty = the bundled conf/cyclonedds.xml on domain 1.
ROS_DOMAIN_ID=
CYCLONEDDS_URI=
CYCLONEDDS_CONFIG=
